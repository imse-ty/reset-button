# Your personal sync key. Make up a long random string and enter it once on each device.
RESET_KEY=

# Web push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (stores your energy system and push subscriptions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (delivers the "30 seconds left" and "Door complete" pushes on time)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional: your public URL, used as the QStash callback. Defaults to the request host.
APP_URL=https://resetbutton.imsety.com
